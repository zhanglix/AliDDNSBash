# Copy to /jffs/addons/cf_ddns/cf_ddns.conf and `chmod 600` it: it holds your API token.
#
# Create the token at https://dash.cloudflare.com/profile/api-tokens with
# "Edit zone DNS" template, scoped to this one zone only.
CF_API_TOKEN="paste-token-here"

CF_ZONE_NAME="example.com"
# CF_ZONE_ID=""              # optional; saves one lookup (cached anyway)

CF_RECORD_NAME="www"   # default record if none is given on the command line:
                        # subdomain ("www", "home.lab"), "@" for the apex, or full name
CF_RECORD_TYPE="A"                 # A (IPv4) or AAAA (IPv6)
CF_PROXIED="keep"                  # true | false | keep
CF_TTL="1"                         # 1 = automatic
CF_CREATE_MISSING="false"

# Public IP services, tried in order; first valid public IP wins. Default (A):
# CF_IP_URLS="https://1.1.1.1/cdn-cgi/trace http://members.3322.org/dyndns/getip https://api.ipify.org https://icanhazip.com"
# CF_CACHE_DIR="/tmp/cf_ddns"
# CF_CURL_OPTS=""   # e.g. "--cacert /jffs/ssl/ca.crt" if curl cannot verify TLS
